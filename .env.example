# Copy to .env and change before running anywhere but your own machine.
POSTGRES_USER=fasm2crud
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fasm2crud
# Password of the least-privilege role the API connects as.
API_DB_PASSWORD=change-me-too

# Host port for the API.
API_HOST_PORT=8080

# CPU split for honest benchmarks on one machine (see docs/ARCHITECTURE.md).
API_CPUS=0-7
PG_CPUS=8-11
